{
  "manifest_version": 3,
  "name": "AI Meeting Assistant",
  "version": "7.1",
  "description": "Real-time Japanese meeting assistant with speaker diarization, standby capture and tab / window / screen recording.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "tabCapture",
    "offscreen",
    "unlimitedStorage"
  ],
  "host_permissions": [
    "https://meet.google.com/*",
    "https://teams.microsoft.com/*",
    "https://teams.live.com/*",
    "https://app.zoom.us/*",
    "https://zoom.us/*",
    "https://*.zoom.us/*",
    "https://generativelanguage.googleapis.com/*",
    "https://api.openai.com/*",
    "https://api.deepseek.com/*"
  ],
  "icons": {
    "16":  "icons/icon-16.png",
    "32":  "icons/icon-32.png",
    "48":  "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "AI Meeting Assistant 7.1",
    "default_icon": {
      "16":  "icons/icon-16.png",
      "32":  "icons/icon-32.png",
      "48":  "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "commands": {
    "toggle-assistant": {
      "suggested_key": { "default": "Alt+Shift+M" },
      "description": "Bật/tắt AI Meeting Assistant"
    },
    "rec-mark": {
      "suggested_key": { "default": "Alt+Shift+K" },
      "description": "Đánh dấu khoảnh khắc quan trọng khi đang ghi"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://meet.google.com/*",
        "https://teams.microsoft.com/*",
        "https://teams.live.com/*",
        "https://app.zoom.us/*",
        "https://zoom.us/*",
        "https://*.zoom.us/*"
      ],
      "css": ["styles.css"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
